  keywords = {Artificial Intelligence (cs.AI),FOS: Computer and information sciences},
  file = {/Users/lex/code/zotero/storage/YDNPRQVR/Li et al. - 2026 - SkillsBench Benchmarking How Well Agent Skills Work Across Diverse Tasks.pdf}
